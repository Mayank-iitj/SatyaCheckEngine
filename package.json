{
  "name": "satyacheck",
  "version": "1.0.0",
  "description": "Blockchain-backed academic credential verification platform",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:contracts": "cd contracts && npx hardhat node",
    "deploy:contracts": "cd contracts && npx hardhat run scripts/deploy.js --network localhost",
    "seed:backend": "cd backend && npx prisma db seed",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:push": "cd backend && npx prisma db push",
    "test:contracts": "cd contracts && npx hardhat test",
    "rebuild:chain": "cd backend && npx tsx scripts/rebuildFromChain.ts",
    "rebuild:chain:dry": "cd backend && npx tsx scripts/rebuildFromChain.ts --dry-run",
    "install:all": "cd contracts && npm install && cd ../backend && npm install && cd ../frontend && npm install",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "start:backend": "cd backend && npm run start",
    "start:frontend": "cd frontend && npm run start",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\""
  },
  "keywords": [
    "blockchain",
    "credentials",
    "verification",
    "education",
    "polygon"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
