// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite does not support enums, using Strings instead.
// UserRole: STUDENT | UNIVERSITY | RECRUITER | ADMIN
// CredentialStatus: VALID | REVOKED
// CredentialType: DEGREE | DIPLOMA | TRANSCRIPT | MICRO_CREDENTIAL | CERTIFICATE
// ExpiryStatus: ACTIVE | EXPIRING_SOON | EXPIRED | NEEDS_RENEWAL
// RecoveryStatus: PENDING | ATTESTED | REJECTED
// BridgeStatus: PENDING | BRIDGED | FAILED
// InstitutionTier: FREE | PRO | ENTERPRISE

// ── Models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String
  walletAddress String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  institution         Institution?
  studentCredentials  Credential[]          @relation("StudentCredentials")
  verificationLogs    VerificationLog[]     @relation("RequesterLogs")
  auditEvents         AuditEvent[]
  jobMatches          JobMatch[]
  skillProfile        SkillProfile?
  recoveryRequests    RecoveryRequest[]     @relation("StudentRecovery")
  verificationReceipts VerificationReceipt[] @relation("CredentialOwnerReceipts")
  jobPostings         JobPosting[]          @relation("RecruiterJobs")

  @@map("users")
}

model Institution {
  id              String    @id @default(uuid())
  userId          String    @unique
  name            String
  country         String
  verified        Boolean   @default(false)
  walletAddress   String?
  publicKey       String?
  reputationScore Float     @default(0)
  logoUrl         String?
  description     String?
  // Staking model
  stakeBond       Float     @default(0)
  tier            String    @default("FREE") // FREE | PRO | ENTERPRISE
  slashCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials       Credential[]
  recoveryRequests  RecoveryRequest[]   @relation("InstitutionRecovery")

  @@map("institutions")
}

model Credential {
  id              String    @id @default(uuid())
  credentialHash  String    @unique
  studentId       String
  institutionId   String
  credentialType  String
  title           String
  description     String?
  recipientName   String
  issueDate       DateTime
  expiryDate      DateTime?
  ipfsCID         String?
  metadataURI     String?
  txHash          String?
  signature       String?
  status          String    @default("VALID")
  revokedReason   String?
  revokedAt       DateTime?
  metadata        Json?
  // Merkle-tree batch issuance
  merkleRoot      String?
  merkleProof     Json?
  batchId         String?
  // Plagiarism detection
  thesisFingerprint String?
  // Expiry tracking
  expiryStatus    String    @default("ACTIVE") // ACTIVE | EXPIRING_SOON | EXPIRED | NEEDS_RENEWAL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  student              User                  @relation("StudentCredentials", fields: [studentId], references: [id])
  institution          Institution           @relation(fields: [institutionId], references: [id])
  verificationLogs     VerificationLog[]
  shareLinks           ShareLink[]
  skillProfileEntries  SkillProfileEntry[]
  verificationReceipts VerificationReceipt[]
  equivalencies        EquivalencyMapping[]
  recoveryRequests     RecoveryRequest[]
  bridgeRequests       BridgeRequest[]

  @@map("credentials")
}

model VerificationLog {
  id           String    @id @default(uuid())
  credentialId String?
  requesterId  String?
  requesterIp  String?
  queryHash    String?
  queryType    String?   // "hash", "qr", "id", "shareLink"
  result       String
  responseTime Int?      // milliseconds
  // Fraud risk breakdown
  fraudRiskScore Json?
  createdAt    DateTime  @default(now())

  // Relations
  credential Credential? @relation(fields: [credentialId], references: [id])
  requester  User?       @relation("RequesterLogs", fields: [requesterId], references: [id])

  @@map("verification_logs")
}

model ShareLink {
  id           String    @id @default(uuid())
  credentialId String
  token        String    @unique
  expiresAt    DateTime
  singleUse    Boolean   @default(false)
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  credential Credential @relation(fields: [credentialId], references: [id])

  @@map("share_links")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_events")
}

// ── NEW: Job Matching ───────────────────────────────────────────────────

model JobPosting {
  id                String   @id @default(uuid())
  recruiterId       String
  title             String
  company           String
  location          String
  description       String
  requiredCredTypes String   // comma-separated: "DEGREE,CERTIFICATE"
  requiredKeywords  String   // comma-separated: "Computer Science,Machine Learning"
  minReputationScore Float   @default(0)
  salaryRange       String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  recruiter  User       @relation("RecruiterJobs", fields: [recruiterId], references: [id])
  matches    JobMatch[]

  @@map("job_postings")
}

model JobMatch {
  id           String   @id @default(uuid())
  jobId        String
  studentId    String
  matchScore   Float    // 0-100
  matchReasons Json     // breakdown of why they matched
  status       String   @default("NEW") // NEW | VIEWED | APPLIED | REJECTED
  createdAt    DateTime @default(now())

  // Relations
  job     JobPosting @relation(fields: [jobId], references: [id])
  student User       @relation(fields: [studentId], references: [id])

  @@unique([jobId, studentId])
  @@map("job_matches")
}

// ── NEW: Skill Profile (Micro-Credential Stacking) ──────────────────────

model SkillProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String   @default("My Skill Profile")
  bio         String?
  totalScore  Float    @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user    User                @relation(fields: [userId], references: [id])
  entries SkillProfileEntry[]

  @@map("skill_profiles")
}

model SkillProfileEntry {
  id           String   @id @default(uuid())
  profileId    String
  credentialId String
  skillTag     String   // e.g. "Machine Learning", "Blockchain", "Data Science"
  weight       Float    @default(1.0) // how much this cred contributes
  createdAt    DateTime @default(now())

  // Relations
  profile    SkillProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  credential Credential   @relation(fields: [credentialId], references: [id])

  @@unique([profileId, credentialId])
  @@map("skill_profile_entries")
}

// ── NEW: Credential Equivalency ─────────────────────────────────────────

model EquivalencyMapping {
  id              String   @id @default(uuid())
  credentialId    String
  sourceCountry   String
  sourceFramework String   // e.g. "Indian B.Tech"
  targetCountry   String
  targetFramework String   // e.g. "US Bachelor of Science"
  confidenceScore Float    // 0-100
  details         Json?    // AI reasoning
  createdAt       DateTime @default(now())

  // Relations
  credential Credential @relation(fields: [credentialId], references: [id])

  @@map("equivalency_mappings")
}

// ── NEW: Thesis Plagiarism Detection ────────────────────────────────────

model ThesisFingerprint {
  id             String   @id @default(uuid())
  credentialHash String?
  fingerprint    String   // SimHash of thesis text
  title          String
  authorName     String
  institutionId  String?
  wordCount      Int      @default(0)
  createdAt      DateTime @default(now())

  @@map("thesis_fingerprints")
}

// ── NEW: Refugee / Disaster Recovery ────────────────────────────────────

model RecoveryRequest {
  id             String    @id @default(uuid())
  studentId      String
  institutionId  String
  credentialId   String?   // null if original credential is lost
  originalTitle  String
  originalType   String
  originalDate   String    // approximate
  evidenceNotes  String?   // any supporting info the student can provide
  status         String    @default("PENDING") // PENDING | ATTESTED | REJECTED
  reviewNotes    String?
  attestedAt     DateTime?
  newCredentialId String?  // the re-issued credential if attested
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  student     User         @relation("StudentRecovery", fields: [studentId], references: [id])
  institution Institution  @relation("InstitutionRecovery", fields: [institutionId], references: [id])
  credential  Credential?  @relation(fields: [credentialId], references: [id])

  @@map("recovery_requests")
}

// ── NEW: Verification Receipts (Consent-based) ──────────────────────────

model VerificationReceipt {
  id              String   @id @default(uuid())
  credentialId    String
  credentialOwnerId String
  verifierIp      String?
  verifierName    String?  // if authenticated
  verifierRole    String?
  queryType       String   // "hash", "qr", "shareLink"
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relations
  credential      Credential @relation(fields: [credentialId], references: [id])
  credentialOwner User       @relation("CredentialOwnerReceipts", fields: [credentialOwnerId], references: [id])

  @@map("verification_receipts")
}

// ── NEW: Cross-Chain Bridging ───────────────────────────────────────────

model BridgeRequest {
  id           String    @id @default(uuid())
  credentialId String
  sourceChain  String    @default("Polygon")
  targetChain  String    // "Ethereum", "BSC", "Arbitrum"
  status       String    @default("PENDING") // PENDING | BRIDGED | FAILED
  sourceTxHash String?
  targetTxHash String?
  bridgedAt    DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  credential Credential @relation(fields: [credentialId], references: [id])

  @@map("bridge_requests")
}

// ── NEW: Platform Stats (Live Leaderboard) ──────────────────────────────

model PlatformStats {
  id                   String   @id @default("global")
  credentialsVerified  Int      @default(0)
  institutionsOnboarded Int     @default(0)
  fraudBlocked         Int      @default(0)
  countriesCovered     Int      @default(0)
  credentialsIssued    Int      @default(0)
  recoveryCompleted    Int      @default(0)
  jobsMatched          Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@map("platform_stats")
}
