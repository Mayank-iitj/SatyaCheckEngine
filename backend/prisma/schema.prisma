generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  clerkId       String?   @unique
  name          String
  role          String    @default("INVESTOR") // INVESTOR | INTERMEDIARY | ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Intermediary {
  id             String    @id @default(uuid())
  registrationNo String    @unique // SEBI Reg No
  name           String
  publicKey      String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Circular {
  id            String    @id @default(uuid())
  title         String
  content       String
  issuerId      String    // Intermediary ID or "SEBI"
  signature     String?   // Ed25519 signature
  c2paHash      String?
  createdAt     DateTime  @default(now())
}

model WhistleblowerReport {
  id            String    @id @default(uuid())
  zkProofHash   String    // The ZKP hash verifying they are an insider
  companyName   String
  reportData    String    // The actual encrypted/anonymous report payload
  status        String    @default("UNVERIFIED") // UNVERIFIED | INVESTIGATING | RESOLVED
  createdAt     DateTime  @default(now())
}

model ScamDomain {
  id            String    @id @default(uuid())
  domain        String    @unique
  targetBroker  String    // e.g. "Zerodha"
  similarityScore Float
  status        String    @default("ACTIVE") // ACTIVE | BLOCKED
  createdAt     DateTime  @default(now())
}

model HeatmapCampaign {
  id          String        @id @default(uuid())
  name        String
  assetName   String        // e.g., "Suzlon Energy"
  createdAt   DateTime      @default(now())
  nodes       HeatmapNode[]
}

model HeatmapNode {
  id            String    @id @default(uuid())
  campaignId    String
  handle        String    // E.g., username or display name
  type          String    // USER | GROUP | CHANNEL
  platform      String    // TELEGRAM | TWITTER | WHATSAPP
  isPatientZero Boolean   @default(false)
  
  campaign      HeatmapCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  edgesSource   HeatmapEdge[] @relation("SourceEdges")
  edgesTarget   HeatmapEdge[] @relation("TargetEdges")
}

model HeatmapEdge {
  id            String    @id @default(uuid())
  sourceId      String
  targetId      String
  messageHash   String
  timestamp     DateTime  @default(now())

  sourceNode    HeatmapNode @relation("SourceEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  targetNode    HeatmapNode @relation("TargetEdges", fields: [targetId], references: [id], onDelete: Cascade)
}

model DeepfakeRecord {
  id            String    @id @default(uuid())
  mediaUrl      String
  confidence    Float     // 0-100%
  anomalies     String    // JSON string of bounding boxes
  createdAt     DateTime  @default(now())
}
